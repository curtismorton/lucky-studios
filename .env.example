# Site
NEXT_PUBLIC_SITE_URL=https://luckystudios.com

# Spotify
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_MARKET=GB

# Contact Form (server-side)
CONTACT_FORM_ENDPOINT=https://formspree.io/f/your_form_id

# Calendly
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-handle

# Supabase (required for CMS and analytics)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# CMS (Supabase-backed content editor)
# Sessions are managed by Supabase Auth (@supabase/ssr) — no separate session
# secret is needed. MFA uses Supabase TOTP (admins enroll via /cms/users).
CMS_ADMIN_TOKEN=set_a_strong_random_token
CMS_CONTENT_TABLE=site_content
CMS_MEDIA_BUCKET=site-media
CMS_MEDIA_PREFIX=homepage
CMS_AUTH_BASE_URL=https://your-site-domain.com
CMS_ALLOWED_EMAIL_DOMAINS=sociallypowerful.com
CMS_ALLOWED_EMAILS=
CMS_ALLOWED_EMAIL_DEFAULT_ROLE=editor
CMS_BOOTSTRAP_ADMIN_EMAILS=
CMS_ENABLE_GOOGLE_OAUTH=false

# CMS V2 Feature Flags
CMS_V2_DASHBOARD_ENABLED=false
CMS_V2_READS_ENABLED=false
CMS_V2_WRITES_ENABLED=false
CMS_LEGACY_ADMIN_READONLY=false
CMS_V2_DEV_BYPASS_AUTH=false
CMS_PREVIEW_SECRET=replace_with_a_strong_secret
